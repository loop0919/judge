# AWS CLI / Terraform profile from ~/.aws/config or ~/.aws/credentials
AWS_PROFILE=

# Cognito login API (optional; /auth/* returns 503 without a client ID)
AWS_REGION=ap-northeast-1
COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=
# Set only for an app client with a secret. Never expose this to the frontend.
COGNITO_CLIENT_SECRET=

# Optional external PostgreSQL URL. make dev starts a local DB when empty.
# External databases require running api/cmd/migrate explicitly.
DATABASE_URL=

# Google login through Cognito (see docs/google-login.md).
NUXT_COGNITO_DOMAIN=
# Use the SAME app client as COGNITO_CLIENT_ID / COGNITO_CLIENT_SECRET above.
NUXT_COGNITO_CLIENT_ID=
NUXT_COGNITO_CLIENT_SECRET=
